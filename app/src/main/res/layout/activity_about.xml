<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/aboutToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/navy"
        app:title="About Application"
        app:titleTextColor="@color/white"
        app:popupTheme="@style/Theme.AppCompat.Light"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ExcessBaggageCalculator"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mobile Technology Assignment"
                android:textSize="15sp"
                android:textColor="@color/grey"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About This Application"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:layout_marginTop="32dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This application estimates excess baggage fees for air travellers. Users can enter baggage weight, select a ticket class and provide a rate per kilogram. The application calculates the excess weight, excess baggage charge and total payable including 8% service tax."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/dark_text"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Developer Information"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:layout_marginTop="28dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name: Nur Farah Aisyah binti Che Taib&#10;Student ID: 2024284586&#10;Group: RCDCS2405A&#10;Programme: CS240&#10;Course: ICT602"
                android:textSize="15sp"
                android:lineSpacingExtra="8dp"
                android:textColor="@color/dark_text"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Application Website"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/navy"
                android:layout_marginTop="28dp"/>

            <TextView
                android:id="@+id/tvGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visit GitHub Repository"
                android:textColor="@color/blue"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2026 ExcessBaggageCalculator. All rights reserved."
                android:textSize="13sp"
                android:textColor="@color/grey"
                android:gravity="center"
                android:layout_marginTop="40dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
